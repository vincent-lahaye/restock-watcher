# --- Cible ---
TARGET_URL=https://boutique.example.com/produit/mon-produit/
PRODUCT_LABEL=Mon produit

# --- Proxy résidentiel (IPRoyal ou compatible) ---
IP_ROYAL_AUTH=user:password
PROXY_ENDPOINT=geo.iproyal.com:12321
REQUIRE_PROXY=true
IMPERSONATE=chrome

# --- LLM de qualification ---
# openai_compatible (Kimi, OpenRouter...) ou anthropic
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.moonshot.ai/v1
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=kimi-k2.6

# --- Notifications ntfy ---
NTFY_SERVER=https://ntfy.sh
# Sur ntfy.sh public, le topic fait office de secret : choisissez une chaîne longue et aléatoire.
NTFY_TOPIC=changez-moi-topic-aleatoire
NTFY_TOKEN=

# --- Cadence (fuseau Europe/Paris) ---
TZ=Europe/Paris
POLL_WINDOWS=08:55-09:45,14:55-15:45
POLL_WINDOW_SECONDS=120
POLL_IDLE_SECONDS=1800
JITTER_SECONDS=30

# --- Robustesse ---
FETCH_TIMEOUT=45
FETCH_RETRIES=2
FAIL_ALERT_THRESHOLD=4
STATE_PATH=/data/state.json
